# Dependencies / build output
/node_modules/
/package-lock.json
/package.json
/test_output.txt
/target/

# Local-only project files
/stories/
# The same, for media too large to sit beside the shelf: `masterpieces/` holds
# the 354 MB hybrid CD (SQ-0870). Tests read it and skip vacuously without it.
# No trailing slash, so this also covers the SYMLINK a worktree carries — a
# pattern ending in `/` matches a directory and would let the link through.
/masterpieces
# …and `treasures/` for the cooked `.iso` pressings of the same kind of disc
# (SQ-0879). Same contract: read when present, skipped vacuously when not, and
# no trailing slash so a worktree's symlink is covered too.
/treasures

# Glulx/Glk conformance test story binaries (fetched, never committed — see
# unit_tests/README.md for the manifest + re-fetch recipe)
/unit_tests/*.ulx
/unit_tests/*.gblorb
/unit_tests/*.blb
/unit_tests/*.z5
# EVERY Z-machine version, not just the one we happened to fetch first. `*.z5`
# stood alone until SQ-1015 found two Version 6 stories sitting here untracked
# and UNIGNORED — Infocom's own in-house ZipTest regression builds, which are
# proprietary — where a single `git add unit_tests/` would have committed them.
# The hard rule against `git add -A` was the only thing standing in the way.
/unit_tests/*.z1
/unit_tests/*.z2
/unit_tests/*.z3
/unit_tests/*.z4
/unit_tests/*.z6
/unit_tests/*.z7
/unit_tests/*.z8
/unit_tests/*.zblorb
/unit_tests/*.dat
# Kickstart ROM images, for the same reason one notch over (SQ-1053). A real
# Amiga Kickstart is copyrighted Commodore code and must never be committed here;
# a dump dropped in this directory to try something out is exactly the accident
# the `.z6` rule above was written for. The ONE exception is our own synthetic
# fixture, which is invented byte for byte by `mk_kickfont_rom.py` and is the
# only `.rom` in the tree.
/unit_tests/*.rom
!/unit_tests/kickfont.rom
# ...and the files those test games WRITE when the suite drives them
# (Glk external files, autosave/save-state dirs, generated blorbs)
/unit_tests/*.glkdata
/unit_tests/*.save/
/unit_tests/*.blorb

# Internal tooling / agent workspaces (machine-local, never committed)
/.claude/
/.worktrees/

# OS / editor junk (ignored anywhere in the tree)
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/
/WAVE_REPORT.md
/.superpowers/

# Locally-fetched test fixtures (SQ-1015). Freely redistributable, but 34 MB of
# third-party game binaries is not something this repo should carry — the plan is a
# fetch manifest CI runs, not committed blobs. Absent, every suite that names one
# falls back to `stories/` and skips vacuously, exactly as it did before.
/crates/app/tests/fixtures/stories/

# A local compose override (library path, ports) is not part of the repo.
docker-compose.override.yml
